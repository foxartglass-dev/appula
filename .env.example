# Appula Configuration

# Server
PORT=4001

# OpenAI Configuration (Required for Phase 2+)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: Custom OpenAI endpoint
OPENAI_PLANNER_MODEL=gpt-4                    # Model for planning (gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.)

# Claude API (Future Phase 3+)
# CLAUDE_API_KEY=your_claude_api_key_here

# Gemini API (Future Phase 5+)
# GEMINI_API_KEY=your_gemini_api_key_here

# Skyvern API (Future Phase 6+)
# SKYVERN_API_KEY=your_skyvern_api_key_here

# Storage Paths (Optional)
# PROJECTS_DIR=./projects
# STATE_DIR=./state
# LOGS_DIR=./state/logs
