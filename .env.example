# Appula Configuration

# Server
PORT=4001

# OpenAI Configuration (Required for Phase 2+)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: Custom OpenAI endpoint
OPENAI_PLANNER_MODEL=gpt-4                    # Model for planning (gpt-4, gpt-4-turbo, o1-mini, o1-preview, etc.)

# Claude API (Future Phase 3+)
# CLAUDE_API_KEY=your_claude_api_key_here

# Claude Code CLI Configuration (Phase 3+)
# Template for invoking Claude Code CLI (leave empty for plan-only mode)
# Placeholders: {projectRoot}, {phaseNumber}, {planPath}, {instructionSummary}
# Example (adjust once you know real CLI flags):
# CLAUDE_CODE_COMMAND_TEMPLATE=claude code --project "{projectRoot}" --plan-file "{planPath}" --phase {phaseNumber}
CLAUDE_CODE_COMMAND_TEMPLATE=

# Timeout in milliseconds (default: 30 minutes)
# CLAUDE_CODE_TIMEOUT_MS=1800000

# Working directory override (optional, defaults to project root)
# CLAUDE_CODE_WORKING_DIR=

# Optional SMS notifications (Twilio) - Phase 4.5
# Leave empty to disable SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555555555
NOTIFY_SMS_TO=+15555555555

# Gemini API + RAG Configuration (Phase 6+)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_RAG_ENDPOINT=https://your-gemini-rag-endpoint.com
# GEMINI_RAG_DATASTORE_ID=your_datastore_id_here

# Skyvern UI Testing API (Phase 7+)
# Leave SKYVERN_API_KEY empty to disable UI testing
SKYVERN_API_KEY=
SKYVERN_BASE_URL=https://api.skyvern.ai
SKYVERN_DEFAULT_APP_URL=http://localhost:3000

# Storage Paths (Optional)
# PROJECTS_DIR=./projects
# STATE_DIR=./state
# LOGS_DIR=./state/logs
